{
  "name": "blueprint",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed architecture diagrams of a codebase or one feature, as one self-contained HTML file in Rasmus Hilmersson's design system.",
  "type": "module",
  "bin": {
    "blueprint": "cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "blueprint": "node cli.mjs"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "elkjs": "0.12.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "puppeteer-core": "25.16.0"
  }
}
